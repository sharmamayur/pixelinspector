{
  "manifest_version": 3,
  "name": "Pixel Inspector – Pixel Helper by PixelMonitor",
  "version": "0.1.7",
  "description": "A pixel helper for ad and analytics platforms. See which pixels fire, what data they send, and which action preceded them.",
  "homepage_url": "https://www.pixelmonitor.app/",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Pixel Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
